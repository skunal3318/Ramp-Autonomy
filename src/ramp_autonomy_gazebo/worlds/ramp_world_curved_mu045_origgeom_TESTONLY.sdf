<?xml version="1.0" ?>
<!--
  ramp_world_curved.sdf

  Same overall layout as ramp_world_sharp.sdf (flat -> ramp -> flat,
  16 deg slope, 1.0 m rise) but the two break points are each replaced
  with a short FILLET made of a few intermediate-angle segments
  instead of one sharp corner. This is the "easy mode" counterpart -
  use it to confirm your break-point / transition logic isn't
  overfit to detecting a single sharp discontinuity, and that speed
  reduction still triggers sensibly when the pitch change is gradual.

  Fillet approach: each corner is approximated with 3 short segments
  stepping through intermediate angles (0 -> ~5.3 -> ~10.7 -> 16 deg
  and the mirror on the way down), each 0.3 m of horizontal run.
  This is a piecewise-linear approximation of a curve, not a true
  spline surface - good enough for slip/pitch-rate testing, not
  intended as a precision CAD ramp.

  PHASE 8 VALIDATION-MATRIX VARIANT (TEST-ONLY): ramp surface friction
  (fillet_bottom_1/2/3, zone_b_ramp_mid, fillet_top_1/2) dropped from
  the normal 0.55 to 0.45, mirroring ramp_world_sharp_lowfriction_
  TESTONLY.sdf's corrected value for phase 8's cross-world friction
  comparison - see README. fillet_top_3 (the near-flat 0-5.33deg tail
  easing back onto zone C) is deliberately left at its normal 0.7,
  matching the original file's own distinction between the climbing-
  critical steep section and the flat-adjacent tail.
-->
<sdf version="1.9">
  <!-- CONTROL WORLD (crest-freeze diagnosis): the ORIGINAL, UNFIXED geometry of ramp_world_curved_mu045_TESTONLY (0.05 m steps at the crest and the ramp foot). Exists only to show the failure on demand and to test the ascent gate. Do not use for anything else. -->
  <world name="ramp_world_curved">

    <!-- type is not what selects the engine: gz-sim loads dartsim either way,
         silently, and Harmonic has no ODE at all. See docs/simulation-world.md
         "Physics engine, and what the friction numbers mean". -->
    <physics name="1ms" type="dart">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry></collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Zone A: flat approach, x 0.0 -> 4.0, z = 0.0 -->
    <model name="zone_a_approach">
      <static>true</static>
      <pose>2.0 0 0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>4.0 3.0 0.1</size></box></geometry>
          <surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>4.0 3.0 0.1</size></box></geometry>
          <material><ambient>0.55 0.55 0.55 1</ambient><diffuse>0.55 0.55 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Bottom fillet: 3 segments, x starting at 4.0, stepping through
         0, 5.33, 10.67 deg pitch, each 0.3 m horizontal run -->
    <model name="fillet_bottom_1">
      <static>true</static>
      <pose>4.15 0 0.014 0 -0.0931 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>0.301 3.0 0.1</size></box></geometry>
        <surface><friction><ode><mu>0.45</mu><mu2>0.45</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><box><size>0.301 3.0 0.1</size></box></geometry>
        <material><ambient>0.45 0.4 0.35 1</ambient><diffuse>0.45 0.4 0.35 1</diffuse></material></visual></link>
    </model>
    <model name="fillet_bottom_2">
      <static>true</static>
      <pose>4.448 0 0.056 0 -0.1863 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>0.301 3.0 0.1</size></box></geometry>
        <surface><friction><ode><mu>0.45</mu><mu2>0.45</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><box><size>0.301 3.0 0.1</size></box></geometry>
        <material><ambient>0.45 0.4 0.35 1</ambient><diffuse>0.45 0.4 0.35 1</diffuse></material></visual></link>
    </model>
    <model name="fillet_bottom_3">
      <static>true</static>
      <pose>4.74 0 0.125 0 -0.2793 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>0.301 3.0 0.1</size></box></geometry>
        <surface><friction><ode><mu>0.45</mu><mu2>0.45</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><box><size>0.301 3.0 0.1</size></box></geometry>
        <material><ambient>0.45 0.4 0.35 1</ambient><diffuse>0.45 0.4 0.35 1</diffuse></material></visual></link>
    </model>

    <!-- Main ramp straight section between the two fillets. Length is
         whatever is needed to make the total rise across both fillets
         plus this section come out to exactly 1.0 m (2.719 m here) -
         a filleted ramp capped at 16 deg peak pitch necessarily runs
         longer than the sharp ramp's 3.49 m horizontal span to gain
         the same 1.0 m of rise, since part of its length is spent
         below peak angle easing into/out of the slope. -->
    <model name="zone_b_ramp_mid">
      <static>true</static>
      <pose>6.192 0 0.541 0 -0.2793 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2.719 3.0 0.1</size></box></geometry>
          <surface><friction><ode><mu>0.45</mu><mu2>0.45</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.719 3.0 0.1</size></box></geometry>
          <material><ambient>0.45 0.4 0.35 1</ambient><diffuse>0.45 0.4 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Top fillet: mirror of the bottom, stepping 16 -> 10.67 -> 5.33 -> 0 deg -->
    <model name="fillet_top_1">
      <static>true</static>
      <pose>7.646 0 0.944 0 -0.1863 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>0.301 3.0 0.1</size></box></geometry>
        <surface><friction><ode><mu>0.45</mu><mu2>0.45</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><box><size>0.301 3.0 0.1</size></box></geometry>
        <material><ambient>0.45 0.4 0.35 1</ambient><diffuse>0.45 0.4 0.35 1</diffuse></material></visual></link>
    </model>
    <model name="fillet_top_2">
      <static>true</static>
      <pose>7.944 0 0.986 0 -0.0931 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>0.301 3.0 0.1</size></box></geometry>
        <surface><friction><ode><mu>0.45</mu><mu2>0.45</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><box><size>0.301 3.0 0.1</size></box></geometry>
        <material><ambient>0.45 0.4 0.35 1</ambient><diffuse>0.45 0.4 0.35 1</diffuse></material></visual></link>
    </model>
    <model name="fillet_top_3">
      <static>true</static>
      <pose>8.244 0 1.0 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>0.301 3.0 0.1</size></box></geometry>
        <surface><friction><ode><mu>0.7</mu><mu2>0.7</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><box><size>0.301 3.0 0.1</size></box></geometry>
        <material><ambient>0.5 0.47 0.42 1</ambient><diffuse>0.5 0.47 0.42 1</diffuse></material></visual></link>
    </model>

    <!-- Zone C: flat exit, x 8.395 -> 12.395, z = 1.0. Starts later than
         the sharp world's zone C (x 7.5) because the fillet + mid-ramp
         chain above needs ~4.4 m of horizontal run (not 3.49 m) to
         reach the same 1.0 m rise while staying at/under 16 deg pitch. -->
    <model name="zone_c_exit">
      <static>true</static>
      <pose>10.395 0 1.05 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>4.0 3.0 0.1</size></box></geometry>
          <surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>4.0 3.0 0.1</size></box></geometry>
          <material><ambient>0.55 0.55 0.55 1</ambient><diffuse>0.55 0.55 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
