<?xml version="1.0" ?>
<!--
  construction_site.sdf

  Realistic construction-site world (phase 8, session A): replaces the two
  isolated ramp-only worlds (ramp_world_sharp.sdf, ramp_world_curved.sdf -
  both kept as-is for regression testing, not modified or deleted here) as
  the primary test environment. This is the STRUCTURAL BLOCKOUT only -
  ground planes, boundary, zone slabs, the ramp itself - at realistic
  full scale, with every key dimension grounded in a cited real-world
  source, not guessed. No detail props/equipment yet (session B).

  See docs/construction_site_design.md for the full engineering
  justification (every dimension below, cited). Summary:

    - Perimeter hoarding: 2.4 m (UK construction-hoarding industry
      standard; exceeds OSHA's 1.83 m / 6 ft commercial-site minimum).
    - One controlled gate, 6.1 m (20 ft) wide - the commonly-applied
      fire-apparatus/construction-access-road standard, sized for
      two-way delivery-truck traffic plus emergency-vehicle access.
    - Elevated level rise: 3.2 m, within the standard 3.0-3.6 m
      single-storey floor-to-floor construction lift height.
    - Ramp: 16 deg slope (this project's own already-validated angle,
      comfortably inside OSHA 1926.451(e)(5)(ii)'s 1:3 / 20 deg maximum
      for ramps and walkways), filleted transitions (3 equal-angle-step
      segments each side, exactly reusing ramp_world_curved.sdf's
      validated design - a sharp seam here is a known, proven failure
      mode from earlier phases and is deliberately not reintroduced),
      0.45 friction (this project's own Phase 8 practical climbing
      floor - 0.35 was confirmed live to NOT be reliably climbable
      despite being above the theoretical tan(16deg)=0.287 minimum).
      Widened to 4.5 m (vs. the earlier ramp worlds' 3.0 m) specifically
      because Phase 8 root-caused a real tip-over on a 3.0 m-wide
      curved-world ramp from lateral drift off the panel edge during
      FollowPath-driven descent - more lateral margin here is a direct,
      deliberate response to that finding, not an arbitrary choice.
    - Laydown area: ~11% of total site footprint, within the commonly-
      cited 10-15% planning guideline.
    - Site office: near the gate, offset off the main delivery/ramp
      corridor, per site-layout guidance (visibility of the site,
      separated from active material-handling paths).
    - Waste/debris staging: separated from both the laydown area and
      the site office, per site-layout guidance (kept apart from
      material storage and from working/living zones).

  Robot spawn: the existing ramp_world.launch.py hardcodes spawn pose
  (x=1.0, y=0.0, z=0.23) for every world (not world-specific) - this
  file's own coordinate system is deliberately built around that
  existing value rather than requiring a launch-file change: the gate
  is at x=0, so x=1.0 lands the robot just inside it, facing +X down
  the access road, with zero changes needed to ramp_world.launch.py.
-->
<sdf version="1.9" xmlns:experimental="http://sdformat.org/schemas/experimental">
  <world name="construction_site">

    <!-- type is not what selects the engine: gz-sim loads dartsim either way,
         silently, and Harmonic has no ODE at all. See docs/simulation-world.md
         "Physics engine, and what the friction numbers mean". -->
    <physics name="1ms" type="dart">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-apply-link-wrench-system" name="gz::sim::systems::ApplyLinkWrench"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 15 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
          <material><ambient>0.35 0.4 0.3 1</ambient><diffuse>0.35 0.4 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="perimeter_west_south">
      <static>true</static>
      <pose>-0.150 -9.525 1.200 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.300 12.950 2.400</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.300 12.950 2.400</size></box></geometry>
          <material><ambient>0.75 0.72 0.68 1</ambient><diffuse>0.75 0.72 0.68 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="perimeter_west_north">
      <static>true</static>
      <pose>-0.150 9.525 1.200 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.300 12.950 2.400</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.300 12.950 2.400</size></box></geometry>
          <material><ambient>0.75 0.72 0.68 1</ambient><diffuse>0.75 0.72 0.68 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- FLOOR 2 EXTENSION: perimeter_east moved from x=59.15 to x=90.15 (site extended 31 m east for Floor 2); north/south fences extended by
         perimeter_north_ext / perimeter_south_ext at the end of this file. Same fence, same height (2.4 m); nothing on the Floor-1 route changed. -->
    <model name="perimeter_east">
      <static>true</static>
      <pose>90.150 0.000 1.200 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.300 32.000 2.400</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.300 32.000 2.400</size></box></geometry>
          <material><ambient>0.75 0.72 0.68 1</ambient><diffuse>0.75 0.72 0.68 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="perimeter_north">
      <static>true</static>
      <pose>29.500 16.150 1.200 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>59.600 0.300 2.400</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>59.600 0.300 2.400</size></box></geometry>
          <material><ambient>0.75 0.72 0.68 1</ambient><diffuse>0.75 0.72 0.68 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="perimeter_south">
      <static>true</static>
      <pose>29.500 -16.150 1.200 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>59.600 0.300 2.400</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>59.600 0.300 2.400</size></box></geometry>
          <material><ambient>0.75 0.72 0.68 1</ambient><diffuse>0.75 0.72 0.68 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="access_road">
      <static>true</static>
      <!-- z corrected from 0.0500 to 0.1000: this slab's pose.z was
           authored as if it were the walking-surface height, but SDF box
           poses are the geometric CENTER, so with this 0.1 m-thick slab
           the real top surface was 0.05 m too low - a genuine authoring
           bug, not a design choice (found via a live loaded-robot freeze
           at construction_site.sdf's ramp-top/elevated_level seam, then
           confirmed by checking every seam's exact top-surface continuity
           - every ramp_fillet_*/ramp_mid seam matches to sub-millimeter
           precision except the two into flat ground-level slabs, both off
           by exactly half this slab thickness - see validation/phase8/
           construction_site_descent/README.md). Raised to keep
           access_road flush with laydown_area (raised the same amount,
           for the same reason - they already matched each other before
           this fix and must stay matched after it). -->
      <pose>4.000 0.000 0.1000 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>8.000 6.100 0.1</size></box></geometry>
          <surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>8.000 6.100 0.1</size></box></geometry>
          <material><ambient>0.55 0.55 0.55 1</ambient><diffuse>0.55 0.55 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="laydown_area">
      <static>true</static>
      <!-- z corrected from 0.0500 to 0.1000, same defect and same fix as
           access_road above: this raises the surface to 0.1500, matching
           ramp_fillet_bottom_1's own left-edge top-surface height
           (0.1498, computed from its pose/size/pitch) to within 2 mm -
           consistent with the sub-mm-to-few-mm tolerance every OTHER
           seam in the ramp_fillet_bottom/ramp_mid/ramp_fillet_top chain
           already has by design. Before this fix there was a real
           0.0498 m vertical step here, undetected until this session
           because the loaded round trip's ascent leg (raw cmd_vel,
           straight, no turning) climbs it reliably regardless - only
           the equivalent step at the ramp's TOP end (elevated_level,
           fixed alongside this one) caused a live, reproducible failure,
           encountered mid-turn under MPPI control. -->
      <pose>18.000 0.000 0.1000 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>20.000 10.000 0.1</size></box></geometry>
          <surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>20.000 10.000 0.1</size></box></geometry>
          <material><ambient>0.6 0.58 0.5 1</ambient><diffuse>0.6 0.58 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="elevated_level">
      <static>true</static>
      <!-- z corrected from 3.2500 to 3.3000: THE root cause of the
           loaded-robot freeze at X~41.33-41.35, confirmed via live
           per-wheel telemetry (motion_stall_detector_node.py's
           /joint_states-derived signals plus a dedicated diagnostic
           node) during a fresh repro - commanded wheel velocity and
           actual wheel velocity matched almost exactly (near-zero
           /wheel_slip) while the chassis's full 6-DOF ground-truth pose
           stayed completely frozen for ~1 s, then lurched forward
           abruptly. This slab's old top surface (3.3000) sat exactly
           0.0500 m below ramp_fillet_top_3's adjoining edge (3.3500) -
           every other seam in the ramp_fillet_bottom/ramp_mid/
           ramp_fillet_top chain matches to sub-millimeter precision, so
           this was a genuine, isolated authoring bug (pose.z set to the
           intended top-surface height without accounting for this being
           the box's CENTER), not a physical/design constraint - a
           100 kg-loaded 0.12 m-radius wheel meeting an unplanned 0.05 m
           ledge mid-turn, under MPPI control, could contact and stick
           against the step's face rather than rolling over it. See
           validation/phase8/construction_site_descent/README.md for the
           full diagnosis and the round-trip reverification after this
           fix. -->
      <pose>48.470 0.000 3.3000 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>15.000 12.000 0.1</size></box></geometry>
          <surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>15.000 12.000 0.1</size></box></geometry>
          <material><ambient>0.62 0.62 0.62 1</ambient><diffuse>0.62 0.62 0.62 1</diffuse></material>
        </visual>
      </link>
    </model>
