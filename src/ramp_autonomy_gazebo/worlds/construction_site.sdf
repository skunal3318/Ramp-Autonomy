    <!-- Office pad: shipping-container-style site office
         (jfrascon/std_cargo_container_40ft, real ISO 40 ft dimensions,
         12.19 x 2.44 x 2.59 m, cited to icontainers.com in the model's
         own source). Too long to fit inside office_pad's own 8x6 m
         walled footprint (a real, more traditional small site-office
         building already modelled there), so placed as a separate,
         common real-world pairing - a secure-storage/second-office
         container just east of the main building, still within the
         "near the gate, off the main corridor" office-zone logic, on
         open ground (container_link's own origin is at the center of
         its bottom face, so pose.z=0 places it exactly on the
         ground_plane with no offset needed). 9.78 m clear of the
         nearest logged ground-truth point - nowhere near the route. -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/jfrascon/models/std_cargo_container_40ft</uri>
      <name>site_office_container</name>
      <static>true</static>
      <pose>17.0 11.0 0 0 0 0</pose>
    </include>

    <!-- Waste pad: a real dumpster (OpenRobotics/Dumpster_Large, real
         box-primitive collision, ~7.19 x 2.65 x up to ~2.7 m). Centred
